        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1200">
    <StackPanel Orientation="Vertical">
    <StackPanel Orientation="Horizontal" Background="#cccccc"  Margin="0,10,0,-6" HorizontalAlignment="Center" Width="845">
        <Image Source="/grafika/1.jpg" x:Name="obraz1" Width="200" Height="200"  MouseLeftButtonDown="obraz1_MouseLeftButtonDown"/>
        <Image Source="/grafika/2.jpg" x:Name="obraz2" Width="200" Height="200"  MouseLeftButtonDown="obraz2_MouseLeftButtonDown"/>
        <Image Source="/grafika/3.jpg" x:Name="obraz3" Width="200" Height="200"  MouseLeftButtonDown="obraz3_MouseLeftButtonDown"/>
            <Image Source="/grafika/pytajnik.jpg" x:Name="obraz4" Width="200" Height="200"  MouseLeftButtonDown="obraz4_MouseLeftButtonDown"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="/grafika/1.jpg" x:Name="obraz" Width="800" Height="600"  />
        
        </StackPanel>
    </StackPanel>

</Window>
